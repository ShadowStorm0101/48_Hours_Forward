<+><!-- app/templates/base.html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n\n  <title>{% block title %}48 Hours Forward{% endblock %}</title>\n\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\">\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css\">\n\n  <style>\n    :root{\n      --green: #1a7a52;\n      --green-dark: #0f3d2e;\n      --bg: #f3fbf6;\n      --card: #ffffff;\n      --text: #0f172a;\n      --muted: #475569;\n      --border: rgba(15, 61, 46, 0.15);\n      --maxw: 1000px;\n    }\n\n    *{ box-sizing: border-box; }\n\n    body{\n      margin: 0;\n      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n    }\n\n    header{\n      background: var(--green-dark);\n      color: #fff;\n      padding: 14px 16px;\n    }\n\n    .top{\n      max-width: var(--maxw);\n      margin: 0 auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n\n    .brand{\n      text-decoration: none;\n      color: #fff;\n      font-weight: 800;\n      letter-spacing: -0.2px;\n      font-size: 18px;\n      white-space: nowrap;\n    }\n\n    nav a{\n      color: rgba(255,255,255,0.9);\n      text-decoration: none;\n      font-weight: 600;\n      margin-left: 10px;\n      white-space: nowrap;\n    }\n    nav a:hover{ text-decoration: underline; }\n\n    main{\n      max-width: var(--maxw);\n      margin: 18px auto;\n      padding: 0 16px;\n    }\n\n    .flash{\n      padding: 10px 12px;\n      border: 1px solid var(--border);\n      background: var(--card);\n      border-radius: 10px;\n      margin-bottom: 10px;\n    }\n\n    .card{\n      border: 1px solid var(--border);\n      background: var(--card);\n      border-radius: 12px;\n      padding: 14px;\n    }\n\n    footer{\n      max-width: var(--maxw);\n      margin: 22px auto;\n      padding: 0 16px;\n      color: var(--muted);\n      font-size: 13px;\n      text-align: center;\n    }\n  </style>\n\n  {% block head %}{% endblock %}\n</head>\n\n<body>\n  <header>\n    <div class=\"top\">\n      <a class=\"brand\" href=\"/\">48 Hours Forward</a>\n\n      <nav>\n        <a href=\"/\">Home</a>\n        <a href=\"/register\">Register</a>\n        <a href=\"/login\">Login</a>\n        <a href=\"/dashboard\">Dashboard</a>\n        <a href=\"/change-password\">Change Password</a>\n        <a href=\"/logout\">Logout</a>\n        \n      </nav>\n    </div>\n  </header>\n\n  <main>\n\n    {% with messages = get_flashed_messages(with_categories=false) %}\n      {% if messages %}\n        {% for message in messages %}\n          <div class=\"flash\">{{ message }}</div>\n        {% endfor %}\n      {% endif %}\n    {% endwith %}\n\n    {% block content %}{% endblock %}\n  </main>\n\n  <footer>\n    <a href=\"https://www.nhs.uk/live-well/addiction-support/addiction-what-is-it/\">NHS addiction</a>\n  </footer>\n\n  {% block scripts %}{% endblock %}\n</body>\n</html>\n
